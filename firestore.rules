rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === TRANSACTIONS ===
    // Users can read/write their own transactions or demo data
    match /transactions/{docId} {
      allow read, write: if request.auth != null || resource.data.userId.matches('demo-.*') || request.resource.data.userId.matches('demo-.*');
    }

    // === FRAUD ALERTS ===
    // Users can read/write their own fraud alerts or demo data
    match /fraudAlerts/{docId} {
      allow read, write: if request.auth != null || resource.data.userId.matches('demo-.*') || request.resource.data.userId.matches('demo-.*');
    }

    // === USER SETTINGS ===
    match /users/{userId} {
      allow read, write: if true;
    }

    match /userSettings/{userId} {
      allow read, write: if true;
    }

    // === DEMO DATA FLAG ===
    match /demoSeeded/{userId} {
      allow read, write: if true;
    }

    // Allow authenticated access by default
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
